# Chat model provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# Optional: override the provider's default model (gpt-4o or claude-opus-5-5)
# LLM_MODEL=gpt-4o

# Required when LLM_PROVIDER=openai.
# Course search always uses OpenAI embeddings, so keep this set with Anthropic too
# if you want the search_courses_by_topic tool to work.
OPENAI_API_KEY=your_openai_api_key_here

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required only for the MCP server's HTTP mode (deno task mcp --transport=http)
# MCP_AUTH_TOKEN=a_long_random_token
